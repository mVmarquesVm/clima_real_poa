# ==========================================================
# Clima Real POA — arquivos que o Git NÃO deve guardar
# ==========================================================

# --- Segredos (senhas, chaves de API, tokens) ---
# Nunca vão para o repositório. Cada pasta terá um arquivo
# de exemplo (.env.example / secrets.example.h) sem valores reais.
.env
.env.*
!.env.example
secrets.h

# --- Python ---
venv/
.venv/
__pycache__/
*.pyc

# --- Banco de dados local (SQLite do backend) ---
*.db
*.sqlite3
*.db-wal
*.db-shm

# --- Front-end (Node só como ferramenta de desenvolvimento) ---
node_modules/
dist/

# --- Lixo do sistema operacional ---
Thumbs.db
desktop.ini
.DS_Store
