{
  "version": 1,
  "author": "Matheus Marques De Souza",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -96,
      "left": 150,
      "attrs": { "temperature": "30", "humidity": "50" }
    },
    {
      "type": "chip-anemometro",
      "id": "anem1",
      "top": 30,
      "left": 230,
      "attrs": { "vento": "2" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 150,
      "left": 200,
      "attrs": { "lux": "50000" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:4", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],
    [ "anem1:SIG", "esp:27", "orange", [] ],
    [ "anem1:GND", "esp:GND.2", "black", [] ],
    [ "ldr1:VCC", "esp:3V3", "red", [] ],
    [ "ldr1:GND", "esp:GND.2", "black", [] ],
    [ "ldr1:AO", "esp:34", "blue", [] ]
  ],
  "dependencies": {}
}
